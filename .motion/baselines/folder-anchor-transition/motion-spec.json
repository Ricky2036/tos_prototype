      "role": "desktop source and expanded glass panel",
      "locator": { "selector": "[data-home-item^='folder:'] [data-folder-shell]" },
      "transformOrigin": [0, 0],
      "provenance": { "kind": "observed", "confidence": 1, "evidenceIds": ["HomeFolderOverlay.prepareMotion"] }
    },
    {
      "id": "folder-icons",
      "role": "shared child application identities",
      "locator": { "selector": ".folder-panel-app" },
      "transformOrigin": [0.5, 0.5],
      "provenance": { "kind": "observed", "confidence": 1, "evidenceIds": ["HomeFolderOverlay.iconMotions"] }
    },
    {
      "id": "folder-title",
      "role": "expanded folder title",
      "locator": { "selector": ".folder-title" },
      "provenance": { "kind": "observed", "confidence": 1, "evidenceIds": ["HomeFolderOverlay.titleRef"] }
    },
    {
      "id": "folder-backdrop",
      "role": "depth-separating blurred backdrop",
      "locator": { "selector": ".folder-backdrop" },
      "provenance": { "kind": "observed", "confidence": 1, "evidenceIds": ["HomeFolderOverlay.backdropRef"] }
    }
  ],
  "tracks": [
    {
