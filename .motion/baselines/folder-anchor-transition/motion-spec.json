{
  "schemaVersion": "motion-spec.v1",
  "meta": {
    "name": "tos-folder-anchor-open-close-baseline",
    "targetPlatform": "mobile-web",
    "framework": "Vue 3",
    "viewport": { "width": 393, "height": 852, "devicePixelRatio": 1 },
    "evidenceClass": "A — inspectable source and deterministic runtime",
    "reference": {
      "kind": "generated-ground-truth",
      "path": "src/components/home/HomeFolderOverlay.vue",
      "durationMs": 320
