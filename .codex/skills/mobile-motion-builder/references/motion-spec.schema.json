{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mobile-motion-builder/motion-spec.v1.schema.json",
  "title": "Motion Spec v1",
  "description": "Contract connecting motion evidence, implementation, and acceptance checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "context", "elements", "tracks", "accessibility", "acceptance"],
  "properties": {
    "schemaVersion": { "const": "motion-spec.v1" },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["targetPlatform", "viewport", "reference"],
      "properties": {
        "name": { "type": "string" },
        "targetPlatform": { "enum": ["mobile-web", "ios", "android", "react-native", "flutter", "unspecified"] },
        "framework": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "devicePixelRatio"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "reference": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["video", "frame-sequence", "static-image", "description", "generated-ground-truth"] },
            "path": { "type": "string" },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "durationMs": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["purpose", "effectSummary", "meaningSummary", "initialState", "targetState"],
      "properties": {
        "purpose": { "enum": ["Transition", "Demonstration", "Guidance", "Feedback", "Visualization", "Highlight", "Aesthetic"] },
        "effectSummary": { "type": "string", "minLength": 1 },
        "meaningSummary": { "type": "string", "minLength": 1 },
        "initialState": { "type": "string", "minLength": 1 },
        "targetState": { "type": "string", "minLength": 1 }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "role", "provenance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "type": "string", "minLength": 1 },
          "parentId": { "$ref": "#/$defs/id" },
          "transformOrigin": {
            "type": "array",
            "prefixItems": [{ "$ref": "#/$defs/normalized" }, { "$ref": "#/$defs/normalized" }],
            "minItems": 2,
            "maxItems": 2
          },
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "elementId", "property", "timing", "model", "provenance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "elementId": { "$ref": "#/$defs/id" },
          "property": { "type": "string", "minLength": 1 },
          "from": {},
          "to": {},
          "timing": {
            "type": "object",
            "required": ["onsetMs", "durationMs"],
            "properties": {
              "onsetMs": { "$ref": "#/$defs/nonNegative" },
              "delayMs": { "$ref": "#/$defs/nonNegative" },
              "durationMs": { "$ref": "#/$defs/nonNegative" },
              "settlingMs": { "$ref": "#/$defs/nonNegative" }
            }
          },
          "model": { "$ref": "#/$defs/model" },
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "coordination": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["type", "trackIds"],
        "properties": {
          "type": { "enum": ["sequence", "parallel", "overlap", "stagger", "sync"] },
          "trackIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "offsetMs": { "type": "number" },
          "staggerMs": { "type": "number" }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trigger": { "enum": ["tap", "press", "drag", "swipe", "scroll", "programmatic", "automatic", "other"] },
        "inputTargetElementId": { "$ref": "#/$defs/id" },
        "interruptBehavior": { "enum": ["cancel-return", "cancel-snap", "queue", "ignored-while-running", "retarget", "retarget-preserve-velocity"] }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotion", "informationEquivalent"],
      "properties": {
        "reducedMotion": { "enum": ["none", "shorten", "remove", "replace-with-fade", "custom"] },
        "customBehavior": { "type": "string" },
        "informationEquivalent": { "type": "boolean" },
        "systemPreferenceBinding": { "type": "string" }
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["metrics", "maxAutomaticIterations", "minimumImprovement", "stopOnHardGateFailure"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "level", "method", "target", "hardGate"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "level": { "enum": ["G0-functional", "G1-semantic", "G2-temporal", "G3-motion", "G4-visual", "G5-quality"] },
              "method": { "type": "string", "minLength": 1 },
              "target": {},
              "tolerance": {},
              "hardGate": { "type": "boolean" }
            }
          }
        },
        "maxAutomaticIterations": { "type": "integer", "minimum": 0, "maximum": 20 },
        "minimumImprovement": { "type": "number", "minimum": 0 },
        "stopOnHardGateFailure": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "nonNegative": { "type": "number", "minimum": 0 },
    "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "required": ["kind", "confidence"],
      "properties": {
        "kind": { "enum": ["observed", "inferred", "chosen"] },
        "confidence": { "$ref": "#/$defs/normalized" },
        "reason": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "easing"],
          "properties": { "type": { "const": "tween" }, "easing": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "keyframes"],
          "properties": {
            "type": { "const": "keyframes" },
            "keyframes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["offset", "value"],
                "properties": { "offset": { "$ref": "#/$defs/normalized" }, "value": {}, "easing": { "type": "string" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "parameterization"],
          "properties": {
            "type": { "const": "spring" },
            "parameterization": { "enum": ["physical", "perceptual"] },
            "mass": { "type": "number", "exclusiveMinimum": 0 },
            "stiffness": { "type": "number", "exclusiveMinimum": 0 },
            "damping": { "type": "number", "minimum": 0 },
            "initialVelocity": { "type": "number" },
            "durationMs": { "type": "number", "exclusiveMinimum": 0 },
            "bounce": { "$ref": "#/$defs/normalized" }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["decay", "gesture-map", "step"] },
            "velocity": { "type": "number" },
            "deceleration": { "type": "number", "exclusiveMinimum": 0 },
            "steps": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
